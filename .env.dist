# Copy to .env and fill in. NEVER commit .env.
#   cp .env.dist .env

# --- Google / Gemini ---
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# Path to service account JSON, kept OUTSIDE the repo (e.g. ~/.config/hummerli/sa.json)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage ---
HUMMERLI_GCS_BUCKET=hummerli-audio-vault
HUMMERLI_DATA_DIR=./data

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Eval feedback loop (auto bug filing & trajectory evaluation) ---
GITHUB_TOKEN=
HUMMERLI_PUBLIC_REPO=palladius/hummerli-b1-adk
HUMMERLI_PRIVATE_REPO=palladius/hummerli-b1-adk-pvt
HUMMERLI_EVAL_JUDGE_MODEL=gemini-2.5-pro
HUMMERLI_EVAL_TRAJECTORY_THRESHOLD=0.85
